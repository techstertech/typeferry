set shell := ['bash', '-eu', '-o', 'pipefail', '-c']
set positional-arguments

image := 'typeferry-template'

# List available recipes.
default:
    @just --list --unsorted

# Install the locked dependency graph.
install:
    npm ci

# Start the Vite and TypeFerry development orchestrator.
develop *args:
    npm run develop -- "$@"

# Run unit, MongoDB integration, and browser tests.
test *args:
    npm test -- "$@"

# Run repository linting with zero warnings.
lint:
    npm run lint

# Check the strict TypeScript contracts.
typecheck:
    npm run typecheck

# Build the production client and server artifacts.
build:
    npm run build

# Build the production container image.
docker-build:
    docker build --tag "{{ image }}" .

# Run the image on the existing Compose database network.
docker-run *args:
    docker run --rm \
        --network "$(docker inspect --format '{{ '{{range .NetworkSettings.Networks}}{{.NetworkID}}{{end}}' }}' "$(docker compose ps --quiet mongodb)")" \
        --env-file .env.server \
        --env CLIENT_ORIGIN=http://localhost:8002 \
        --env 'DATABASE_URL=mongodb://mongodb:27017/typeferry-template?replicaSet=rs0&directConnection=true' \
        --publish 8002:8002 \
        "{{ image }}" "$@"
