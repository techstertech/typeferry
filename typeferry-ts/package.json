{
  "name": "typeferry",
  "version": "0.15.1",
  "description": "Type-safe real-time RPC framework for TypeScript",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "bin": {
    "typeferry": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/decorators": {
      "types": "./dist/server/decorators/index.d.ts",
      "import": "./dist/server/decorators/index.js"
    },
    "./server/transports": {
      "types": "./dist/server/transports/index.d.ts",
      "import": "./dist/server/transports/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./auth/server/oauth": {
      "types": "./dist/auth/server/oauth/index.d.ts",
      "import": "./dist/auth/server/oauth/index.js"
    },
    "./auth/client/oauth": {
      "types": "./dist/auth/client/oauth/index.d.ts",
      "import": "./dist/auth/client/oauth/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./ejson": {
      "types": "./dist/ejson/index.d.ts",
      "import": "./dist/ejson/index.js"
    },
    "./minimongo": {
      "types": "./dist/minimongo/index.d.ts",
      "import": "./dist/minimongo/index.js"
    },
    "./mongodb": {
      "types": "./dist/mongodb/index.d.ts",
      "import": "./dist/mongodb/index.js"
    },
    "./mongodb/decorators": {
      "types": "./dist/mongodb/decorators/index.d.ts",
      "import": "./dist/mongodb/decorators/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./config": {
      "types": "./dist/application/config.d.ts",
      "import": "./dist/application/config.js"
    },
    "./test": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js"
    },
    "./auth/client": {
      "types": "./dist/auth/client/index.d.ts",
      "import": "./dist/auth/client/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/prepare-dist.mjs",
    "verify:consumer": "node ../scripts/verify-application-consumer.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:browser",
    "test:watch": "npm run test:unit:watch",
    "test:unit": "vitest --config vitest.config.unit.ts --run --watch=false",
    "test:unit:watch": "vitest --config vitest.config.unit.ts --watch",
    "test:coverage": "vitest --config vitest.config.unit.ts --run --coverage",
    "test:integration": "vitest --config vitest.config.integration.ts --run --watch=false",
    "test:interop:ruby": "TYPEFERRY_RUBY_INTEGRATION=1 vitest --config vitest.config.integration.ts --run --watch=false src/test/conformance/cross-lang-rb.integration.spec.ts",
    "test:integration:watch": "vitest --config vitest.config.integration.ts --watch",
    "test:browser": "vitest --config vitest.config.browser.ts --run --watch=false",
    "test:browser:watch": "vitest --config vitest.config.browser.ts --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@hono/node-server": "^2.1.1",
    "@lukeed/uuid": "^2.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "esbuild": "0.28.1",
    "fast-deep-equal": "^3.1.3",
    "google-auth-library": "^10.9.0",
    "hono": "^4.13.7",
    "jiti": "^2.6.1",
    "jsonwebtoken": "^9.0.2",
    "limiter": "^2.1.0",
    "memoizee": "^0.4.15",
    "playwright": "1.62.1",
    "query-string": "^9.5.0",
    "redis": "^4.6.7",
    "tailwindcss": "^4.3.3",
    "tree-kill": "^1.2.2",
    "ua-parser-js": "^2.0.10",
    "use-debounce": "^10.1.1",
    "vite": "^8.2.2",
    "vitest": "4.1.12",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8 <9",
    "@react-oauth/google": ">=0.12",
    "mongodb": ">=6",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@react-oauth/google": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@react-oauth/google": "^0.12.2",
    "@testing-library/react": "^16.3.2",
    "@types/json-stable-stringify": "^1",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/memoizee": "^0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sinon": "^10.0.16",
    "@types/ua-parser-js": "^0.7.39",
    "@types/ws": "^8",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.9.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "mongodb": "^7.5.0",
    "postcss": "^8.5.26",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sinon": "^18.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "brace-expansion": "^5.0.9",
    "form-data": "^4.0.6",
    "ip-address": "^10.5.0",
    "nanoid": "^6.0.1",
    "postcss": "^8.5.26",
    "qs": "^6.15.3",
    "undici": "^7.29.0",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=24.19.0 <27",
    "npm": "11.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "esbuild": true,
    "es5-ext": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardoventurini/typeferry.git",
    "directory": "typeferry-ts"
  },
  "homepage": "https://github.com/leonardoventurini/typeferry#readme",
  "bugs": {
    "url": "https://github.com/leonardoventurini/typeferry/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
