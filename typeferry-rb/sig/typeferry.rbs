module TypeFerry
  VERSION: String

  module AuthenticationResult
    def self.accepted?: (untyped value) -> bool
  end

  module EJSON
    self.@custom_factories: Hash[String, Proc]

    VALID_REGEXP_FLAGS: String
    MAX_ARRAY_INDEX: Integer
    TAG_KEYS: Array[Array[String]]

    class DateValue < Struct[Integer]
      attr_reader milliseconds: Integer
      def initialize: (milliseconds: Integer) -> void
      def self.new: (milliseconds: Integer) -> DateValue
                   | (milliseconds: Integer, **untyped) -> DateValue
    end

    class RegexpValue < Struct[String | nil]
      attr_reader source: String
      attr_reader flags: String
      def initialize: (source: String, flags: String) -> void
      def self.new: (source: String, flags: String) -> RegexpValue
                   | (source: String, flags: String, **untyped) -> RegexpValue
    end

    class BinaryValue < Struct[String]
      attr_reader bytes: String
      def initialize: (bytes: String) -> void
      def self.new: (bytes: String) -> BinaryValue
                   | (bytes: String, **untyped) -> BinaryValue
    end

    class CustomValue < Struct[untyped]
      attr_reader type_name: String
      attr_reader value: untyped
      def initialize: (type_name: String, value: untyped) -> void
      def self.new: (type_name: String, value: untyped) -> CustomValue
                   | (type_name: String, value: untyped, **untyped) -> CustomValue
    end

    def self.add_type: (String name) { (untyped) -> untyped } -> Proc
    def self.clear_types: () -> Hash[String, Proc]
    def self.parse: (String source) -> untyped
    def self.stringify: (untyped value, ?canonical: bool, ?indent: bool | Integer | String | nil) -> String
    def self.to_json_value: (untyped value) -> untyped
    def self.from_json_value: (untyped value) -> untyped

    private

    def self.convert_object: (untyped value) -> untyped
    def self.convert_json: (Hash[String, untyped] value) -> untyped
    def self.exact_keys?: (Hash[String, untyped] value, *String keys) -> bool
    def self.tag_shape?: (Hash[untyped, untyped] value) -> bool
    def self.regexp_flags: (Regexp value) -> String
    def self.sanitize_flags: (untyped value) -> String
    def self.inf_nan: (Float value) -> (Float | Hash[String, Integer])
    def self.decode_inf_nan: (untyped sign) -> Float
    def self.decode_base64: (untyped value) -> String
    def self.order_properties: (untyped value, ?canonical: bool) -> untyped
    def self.array_index_key?: (String key) -> bool
  end

  module Protocol
    HTTP_PATH: String
    WEBSOCKET_PATH: String
    NO_CHANNEL: String
    AUTH_TIMEOUT_MS: Integer
    PING_INTERVAL_MS: Integer
    DEFAULT_CACHE_MAX_AGE_MS: Integer
    REDIS_EVENTS_CHANNEL: String

    module MessageType
      RPC: String
      RPC_VOID: String
      RPC_RESPONSE: String
      EVENT: String
      AUTH: String
      PING: String
      PONG: String
    end

    module Methods
      RPC_ON: String
      RPC_OFF: String
      RPC_LOGIN: String
      RPC_LOGOUT: String
      LIST_METHODS: String
    end

    module Errors
      AUTHENTICATION_FAILED: String
      EVENT_FORBIDDEN: String
      EVENT_NOT_FOUND: String
      EVENT_NOT_PROVIDED: String
      EVENT_NOT_SUBSCRIBED: String
      INTERNAL_ERROR: String
      INVALID_METHOD_NAME: String
      INVALID_PARAMS: String
      INVALID_REQUEST: String
      INVALID_TOKEN: String
      METHOD_FORBIDDEN: String
      METHOD_NOT_FOUND: String
      METHOD_NOT_SPECIFIED: String
      PARAMS_NOT_FOUND: String
      PARSE_ERROR: String
      SUBSCRIPTION_ERROR: String
      RATE_LIMIT_EXCEEDED: String
    end
  end

  class PublicError < StandardError
  end

  class SchemaValidationError < PublicError
    attr_reader errors: Array[String]
    def initialize: (Array[String] errors) -> void
  end

  class ValidationIssue
    attr_reader path: Array[String]
    attr_reader message: String
    def initialize: (Array[String] path, String message) -> void
    def format: () -> String
  end

  class ValidationResult
    attr_reader success: bool
    attr_reader data: untyped
    attr_reader issues: Array[ValidationIssue]
    def initialize: (bool success, untyped data, Array[ValidationIssue] issues) -> void
  end

  module Context
    KEY: Symbol
    def self.current: () -> (Hash[Symbol, untyped] | nil)
    def self.with: (Hash[Symbol, untyped] value) { () -> untyped } -> untyped
  end

  class ProcessResult
    attr_reader status: Symbol
    attr_reader exit_status: Integer?
    attr_reader term_signal: Integer?
    attr_reader error: Exception?
    def initialize: (status: Symbol, exit_status: Integer?, term_signal: Integer?, error: Exception?) -> void
    def success?: () -> bool
  end

  class ProcessJob
    attr_reader id: String
    attr_reader pid: Integer?
    def initialize: (ProcessSupervisor supervisor, id: String, command: Array[String], environment: Hash[String, String], directory: String?, timeout: Float?, stdin: untyped, stdout: untyped, stderr: untyped, unset_environment: bool) -> void
    def start: () -> ProcessJob
    def cancel: () -> true
    def wait: (?timeout: Float?) -> ProcessResult
    def result: () -> ProcessResult?
    def active?: () -> bool
    private
    def monitor_process: () -> void
    def terminate_and_finish: (Symbol status) -> ProcessResult
    def reap: (no_hang: bool) -> untyped
    def exit_result: (untyped status) -> ProcessResult
    def cancel_requested?: () -> bool
    def timed_out?: () -> bool
    def finish: (ProcessResult value) -> ProcessResult
    def monotonic_now: () -> Float
  end

  class ProcessSupervisor
    class ClosedError < StandardError
    end

    class WaitTimeout < StandardError
    end

    attr_reader poll_interval: Float
    attr_reader termination_grace: Float
    def initialize: (?poll_interval: Float, ?termination_grace: Float) -> void
    def start: (id: String, command: Array[String], ?environment: Hash[untyped, untyped], ?directory: String?, ?timeout: Float?, ?stdin: untyped, ?stdout: untyped, ?stderr: untyped, ?unset_environment: bool) -> ProcessJob
    def active?: (String id) -> bool
    def cancel: (String id) -> bool
    def close: () -> true
    def finish: (ProcessJob job) -> untyped
    def signal_process_group: (Integer pid, String signal) -> bool
    def terminate_process_group: (Integer pid) -> true
    private
    def validate_start: (String id, Array[String] command, Float? timeout) -> void
    def normalize_environment: (Hash[untyped, untyped] environment) -> Hash[String, String]
    def monotonic_now: () -> Float
  end

  class ClientNode
    attr_reader socket: untyped
    attr_reader uuid: String
    attr_reader context: untyped
    attr_reader user_id: String?
    attr_reader response_headers: Array[untyped]
    attr_reader headers: Hash[String, String]
    attr_reader remote_address: String
    attr_reader user_agent: String
    attr_accessor authenticated: bool
    attr_accessor server: Server?
    attr_accessor meta: Hash[String, untyped]
    def initialize: (?socket: untyped, ?uuid: String, ?context: untyped, ?headers: Hash[untyped, untyped], ?remote_address: String, ?user_agent: String) -> void
    def set_context: (untyped context) -> untyped
    def emit_event: (String event, String channel, untyped params) -> untyped
    def emit_auth_result: (bool value) -> untyped
    def close: () -> untyped
  end

  class Method
    @entries: Hash[String, Hash[Symbol, untyped]]
    attr_reader name: String
    def initialize: (String name, Proc handler, ?protected: bool, ?cache: bool, ?max_age_ms: Integer, ?schema: untyped, ?middleware: Array[Proc], ?clock: Proc?) -> void
    def protected?: () -> bool
    def call: (ClientNode? node, untyped params) -> untyped
    private
    def validate: (untyped params) -> void
    def cached_value: (String key) -> Hash[Symbol, untyped]?
    def store: (String key, untyped value) -> void
  end

  class RoomRegistry
    @rooms: Hash[String, Set[untyped]]
    @socket_rooms: Hash[untyped, Set[String]]
    def initialize: () -> void
    def join: (untyped socket, String room) -> untyped
    def leave: (untyped socket, String room) -> untyped
    def leave_all: (untyped socket) -> untyped
    def broadcast: (String room, String payload, ?exclude_uuid: String?) -> untyped
    def include?: (untyped socket, String room) -> bool
    def size: (String room) -> Integer
  end

  class Event
    attr_reader name: String
    def initialize: (String name, server: Server, ?protected: bool, ?user: bool, ?cluster: bool, ?exclude_originator: bool, ?should_subscribe: Proc?) -> void
    def subscribable?: (ClientNode node, String channel) -> bool
    def emit: (String channel, ?untyped params) -> untyped
  end

  class Server
    @methods: Hash[String, Method]
    @events: Hash[String, Event]
    @clients: Hash[String, ClientNode]
    @listeners: Hash[Symbol, Array[Proc]]
    attr_reader rooms: RoomRegistry
    attr_reader methods: Hash[String, Method]
    attr_reader events: Hash[String, Event]
    attr_reader uuid: String
    attr_reader redis_transport: untyped
    def initialize: (**untyped options) -> void
    def add_method: (String name, ?Proc? handler, **untyped options) ?{ (ClientNode?, untyped) -> untyped } -> Method
    def add_event: (String name, **untyped options) -> Event
    def register: (untyped target) -> untyped
    def call: (String name, ?untyped params, ?node: ClientNode?) -> untyped
    def set_auth: (auth: Proc, log_in: Proc) -> Method
    def authenticate: (ClientNode node, untyped context) -> untyped
    def attach_redis: (untyped transport) -> untyped
    def set_channel_authorization: (Proc callable) -> Proc
    def add_client: (ClientNode node) -> ClientNode
    def delete_client: (ClientNode node) -> bool
    def clients_for_user: (String user_id) -> Array[ClientNode]
    def client_snapshot: () -> Array[ClientNode]
    def disconnect_user: (String user_id) -> Array[ClientNode]
    def on_server_event: (Symbol name) { (untyped) -> untyped } -> Array[Proc]
    def emit_server_event: (Symbol name, untyped payload) -> Array[Proc]
    def propagate: (String event, String channel, String payload, ?exclude_uuid: String?, ?cluster: bool) -> untyped
    def close: () -> true
    private
    def install_default_methods: () -> Method
    def subscription_result: (ClientNode node, Hash[String, untyped]? params, subscribe: bool) -> Hash[String, bool]
    def room_name: (String channel, String event) -> String
  end

  module Authoring
    def namespace: (String value) -> String
    def protected_by_default: () -> Hash[Symbol, untyped]
    def cache_by_default: (?max_age_ms: Integer) -> Hash[Symbol, untyped]
    def method: (Symbol ruby_name, ?name: String?, ?public: bool, ?cache: bool?, ?schema: untyped, ?middleware: Array[Proc]) ?{ (ClientNode?, untyped) -> untyped } -> Array[Hash[Symbol, untyped]]
    def typeferry_methods: () -> Array[Hash[Symbol, untyped]]
    private
    def typeferry_defaults: () -> Hash[Symbol, untyped]
  end

  module Transports
    class RequestBodyTooLarge < StandardError
    end

    class RackSecurityPolicy
      DEFAULT_MAX_BODY_BYTES: Integer
      def initialize: (?origins: Array[String]?, ?allow_originless: bool, ?max_body_bytes: Integer, ?client_address_resolver: Proc?) -> void
      def origin_allowed?: (String? origin) -> bool
      def read_body: (untyped request) -> String
      def client_address: (untyped request) -> String
    end

    class RackWebSocket
      RESPONSE_HEADERS: Hash[String, String]
      def initialize: (Server server, ?origins: Array[String]?, ?handshake_authenticator: Proc?, ?allow_originless: bool) -> void
      def call: (Hash[String, untyped] environment) -> [Integer, Hash[String, String], Array[String]]
      def close: () -> true
      private
      def closed?: () -> bool
      def remove_connection: (RackWebSocketConnection connection) -> untyped
      def response: (Integer status, String body) -> [Integer, Hash[String, String], Array[String]]
    end

    class RackWebSocketConnection
      READ_SIZE: Integer
      MAX_FRAME_BYTES: Integer
      attr_reader env: Hash[String, untyped]
      attr_reader url: String
      attr_reader uuid: String
      def initialize: (Hash[String, untyped] environment, Server server, handshake_authenticator: Proc?, on_close: untyped) -> void
      def start: () -> Thread
      def write: (String bytes) -> untyped
      def send_text: (String payload) -> untyped
      def pong!: () -> true
      def close: (?Integer code) -> untyped
      private
      def closed?: () -> bool
      def install_callbacks: () -> untyped
      def read_frames: () -> untyped
      def finish: () -> untyped
      def websocket_url: (Hash[String, untyped] environment) -> String
      def query_values: (untyped source) -> Hash[String, String]
      def handshake_snapshot: (Hash[String, untyped] environment) -> Hash[Symbol, untyped]
    end

    class WebSocketHeartbeat
      def initialize: (WebSocketDispatcher dispatcher, untyped socket, ?interval_ms: Integer) -> void
      def start: () -> Thread
      def mark_pong: () -> true
      def stop: () -> true
      private
      def run: () -> untyped
    end

    class RedisTransport
      EVENTS_CHANNEL: String
      SERVERS_KEY: String
      DEFAULT_URL: String
      RECONNECT_DELAY: Float
      attr_reader server: Server
      attr_reader url: String
      def initialize: (Server server, ?url: String, ?client_factory: Proc?) -> void
      def connect: () -> RedisTransport
      def wait_ready: (?timeout: Float) -> true
      def publish: (event: String, channel: String, message: String, ?exclude_uuid: String?) -> untyped
      def register_client: (ClientNode node) -> untyped
      def remove_client: (ClientNode node) -> untyped
      def stats: () -> Hash[String, untyped]
      def close: () -> true
      private
      def listen: () -> untyped
      def consume: (untyped subscriber) -> untyped
      def route: (String payload) -> untyped
      def publisher_call: (*String command) -> untyped
      def rebuild_users: () -> untyped
      def server_clients: () -> Array[ClientNode]
      def clients_key: () -> String
      def users_key: () -> String
      def closed?: () -> bool
      def mark_ready: () -> untyped
      def interruptible_wait: (Float seconds) -> untyped
      def monotonic_now: () -> Float
    end
  end

  module Auth
    class DeviceInfo < Data
      attr_reader ip: String?
      attr_reader user_agent: String?
      attr_reader os: String?
      attr_reader browser: String?
      attr_reader device_type: String?
      def initialize: (?ip: String?, ?user_agent: String?, ?os: String?, ?browser: String?, ?device_type: String?) -> void
      def self.new: (?ip: String?, ?user_agent: String?, ?os: String?, ?browser: String?, ?device_type: String?) -> DeviceInfo
    end

    class AccessTokenPayload < Data
      attr_reader user_id: String
      attr_reader session_id: String
      attr_reader iat: Integer
      attr_reader exp: Integer
      attr_reader claims: Hash[String, untyped]?
      def initialize: (user_id: String, session_id: String, iat: Integer, exp: Integer, ?claims: Hash[String, untyped]?) -> void
      def self.new: (user_id: String, session_id: String, iat: Integer, exp: Integer, ?claims: Hash[String, untyped]?) -> AccessTokenPayload
    end

    class TokenPair < Data
      attr_reader access_token: String
      attr_reader refresh_token: String
      attr_reader exp: Integer
      def initialize: (access_token: String, refresh_token: String, exp: Integer) -> void
      def self.new: (access_token: String, refresh_token: String, exp: Integer) -> TokenPair
    end

    class CookieOptions < Data
      attr_reader name: String
      attr_reader max_age_days: Integer
      attr_reader secure: bool?
      attr_reader same_site: String
      attr_reader path: String
      def initialize: (name: String, max_age_days: Integer, ?secure: bool?, ?same_site: String, ?path: String) -> void
      def self.new: (name: String, max_age_days: Integer, ?secure: bool?, ?same_site: String, ?path: String) -> CookieOptions
    end

    class Config < Data
      attr_reader secret: String
      attr_reader algorithm: String
      attr_reader access_token_expiry_minutes: Integer
      attr_reader refresh_token_expiry_days: Integer
      attr_reader rotation_grace_period_seconds: Integer
      attr_reader login_rate_limit: untyped
      attr_reader refresh_rate_limit: untyped
      def initialize: (secret: String, ?algorithm: String, ?access_token_expiry_minutes: Integer, ?refresh_token_expiry_days: Integer, ?rotation_grace_period_seconds: Integer, ?login_rate_limit: untyped, ?refresh_rate_limit: untyped) -> void
      def self.new: (secret: String, ?algorithm: String, ?access_token_expiry_minutes: Integer, ?refresh_token_expiry_days: Integer, ?rotation_grace_period_seconds: Integer, ?login_rate_limit: untyped, ?refresh_rate_limit: untyped) -> Config
    end

    class Session
      attr_accessor id: String
      attr_accessor user_id: String
      attr_accessor family_id: String
      attr_accessor token: String
      attr_accessor expiration: Integer
      attr_accessor device_info: DeviceInfo?
      attr_accessor is_revoked: bool
      attr_accessor replaced_by: String?
      attr_accessor used_at: Float?
      def initialize: (id: String, user_id: String, family_id: String, token: String, expiration: Integer, ?device_info: DeviceInfo?, ?is_revoked: bool, ?replaced_by: String?, ?used_at: Float?) -> void
      def initialize_copy: (Session source) -> void
    end

    def self.sign_access_token: (AccessTokenPayload payload, Config config) -> String
    def self.verify_access_token: (String token, Config config, ?clock: untyped) -> AccessTokenPayload?
    def self.decode_token: (String token) -> AccessTokenPayload?
    def self.set_refresh_token_cookie: (String token, CookieOptions options, ?production: bool) -> String
    def self.clear_refresh_token_cookie: (name: String, ?secure: bool?, ?same_site: String, ?path: String, ?production: bool) -> String
    def self.get_refresh_token_from_cookie_header: (String? header, String name) -> String?
    def self.parse_device_info: (Hash[String, untyped]? headers, ?remote_address: String?) -> DeviceInfo

    private
    def self.payload_to_wire: (AccessTokenPayload payload) -> Hash[String, untyped]
    def self.payload_from_wire: (Hash[String, untyped] payload) -> AccessTokenPayload
    def self.clean_token: (String token) -> String
    def self.encode_cookie: (String value) -> String
    def self.header: (Hash[String, untyped] headers, String name) -> String?
    def self.user_agent_details: (String value) -> Hash[Symbol, String?]
    def self.safari: (String value) -> String
    def self.chrome: (String value) -> String?
    def self.desktop_browser: (String value) -> String?

    class InMemorySessionManager
      attr_reader config: Config
      def initialize: (Config config, ?clock: Proc) -> void
      def create_session: (String user_id, ?DeviceInfo? device_info) -> TokenPair
      def refresh_session: (String refresh_token, ?DeviceInfo? device_info) -> TokenPair?
      def revoke_session: (String session_id) -> bool
      def revoke_family: (String family_id) -> Integer
      def user_sessions: (String user_id) -> Array[Session]
      def revoke_all_user_sessions: (String user_id, ?except_family_id: String?) -> Integer
      def session_for: (String refresh_token) -> Session?
      def size: () -> Integer
      def cleanup: () -> Hash[String, Session]
      def close: () -> true
      private
      def rotate: (Session session, DeviceInfo? device_info) -> TokenPair
      def reused_token: (Session session) -> TokenPair?
      def revoke_family_unlocked: (String family_id) -> Integer
      def build_session: (String id, String user_id, String family_id, String token, DeviceInfo? device_info) -> Session
      def build_token_pair: (String refresh_token, String user_id, String session_id) -> TokenPair
      def now_seconds: () -> Integer
      def now_milliseconds: () -> Float
      def fresh_id: () -> String
    end

    module OAuth
      class GoogleConfig < Data
        attr_reader client_id: String
        attr_reader client_secret: String
        attr_reader redirect_uri: String
        attr_reader token_endpoint: String
        attr_reader jwks_endpoint: String
        def initialize: (client_id: String, client_secret: String, ?redirect_uri: String, ?token_endpoint: String, ?jwks_endpoint: String) -> void
        def self.new: (client_id: String, client_secret: String, ?redirect_uri: String, ?token_endpoint: String, ?jwks_endpoint: String) -> GoogleConfig
      end

      class GoogleUser < Data
        attr_reader provider_id: String
        attr_reader provider: String
        attr_reader email: String?
        attr_reader email_verified: bool
        attr_reader name: String?
        attr_reader picture: String?
        attr_reader raw: Hash[String, untyped]
        def initialize: (provider_id: String, provider: String, email: String?, email_verified: bool, name: String?, picture: String?, raw: Hash[String, untyped]) -> void
        def self.new: (provider_id: String, provider: String, email: String?, email_verified: bool, name: String?, picture: String?, raw: Hash[String, untyped]) -> GoogleUser
      end

      class GoogleProvider
        attr_reader name: String
        def initialize: (GoogleConfig config, ?http: untyped) -> void
        def exchange_code: (String code) -> GoogleUser
        private
        def post_form: (String endpoint, Hash[String, String] form) -> Hash[String, untyped]
        def verify: (String token) -> Hash[String, untyped]
        def get_json: (String endpoint) -> Hash[String, untyped]
        def parse_response: (untyped response) -> Hash[String, untyped]
        def string_value: (untyped value) -> String?
      end
    end
  end
end

module Base64
  def self.strict_encode64: (String value) -> String
  def self.strict_decode64: (String value) -> String
end

module JSON
  class ParserError < StandardError
  end

  class GeneratorError < StandardError
  end

  class State
    def initialize: (**untyped) -> void
  end

  def self.parse: (String source) -> untyped
  def self.generate: (untyped value, ?State state) -> String
end

class Monitor
  def self.new: () -> Monitor
  def synchronize: [T] () { () -> T } -> T
end

module SecureRandom
  def self.uuid: () -> String
end

class RedisClient
  class Error < StandardError
  end

  class ConnectionError < Error
  end

  def self.config: (url: String) -> untyped
end

module Rack
  class Request
    def self.new: (Hash[String, untyped]) -> Request
    def path: () -> String
    def post?: () -> bool
    def ip: () -> String
    def body: () -> IO
    def get_header: (String name) -> untyped
  end
end

module URI
  def self.decode_www_form: (String source) -> Array[[String, String]]
  def self.parse: (String source) -> untyped
end

module JWT
  class DecodeError < StandardError
  end
  def self.encode: (Hash[String, untyped] payload, untyped key, String algorithm, ?Hash[String, untyped] header) -> String
  def self.decode: (String token, untyped key, bool verify, **untyped options) -> [Hash[String, untyped], Hash[String, untyped]]
end

module Net
  class HTTPSuccess
    def body: () -> String
  end

  class HTTP
    def self.start: (String hostname, Integer port, **untyped options) { (untyped) -> untyped } -> untyped

    class Post
      def self.new: (untyped uri) -> untyped
    end

    class Get
      def self.new: (untyped uri) -> untyped
    end
  end
end

module WebSocket
  class Driver
    def self.websocket?: (Hash[String, untyped] environment) -> bool
    def self.rack: (untyped socket, ?max_length: Integer) -> untyped
  end
end

module TypeFerry
  module Transports
    class RateLimit
      attr_reader max: Integer
      attr_reader window_ms: Integer
      def initialize: (?Integer max, ?Integer window_ms) -> void
    end

    class SlidingWindowLimiter
      @entries: Hash[String, Array[Integer]]

      def initialize: (RateLimit limit, ?clock: Proc?) -> void
      def consume: (String key) -> [bool, Integer, Integer]
    end

    class RackHTTP
      CONTENT_TYPE: String
      def initialize: (Server server, ?origins: Array[String]?, ?rate_limit: RateLimit?, ?allow_originless: bool, ?max_body_bytes: Integer, ?client_address_resolver: Proc?) -> void
      def call: (Hash[String, untyped] environment) -> [Integer, Hash[String, String], Array[String]]
      private
      def dispatch: (untyped request, String client_address) -> [Integer, Hash[String, String], Array[String]]
      def decode: (String body) -> untyped
      def build_node: (untyped request, untyped context, String client_address) -> ClientNode
      def request_headers: (Hash[String, untyped] environment) -> Hash[String, String]
      def error: (String message, ?uuid: String?, ?method: String?, ?errors: Array[String]?, ?void: bool) -> [Integer, Hash[String, String], Array[String]]
      def response: (Integer status, String body, ?Array[[String, String]] headers) -> [Integer, Hash[String, String], Array[String]]
      def rate_headers: (Integer remaining, Integer reset_ms) -> Array[[String, String]]
    end

    class WebSocketDispatcher
      UUID_PATTERN: Regexp
      MAX_UUID_LENGTH: Integer
      MAX_META_SIZE: Integer
      attr_reader node: ClientNode
      def initialize: (Server server, untyped socket, ?query: Hash[String, String], ?handshake_authenticator: Proc?, ?handshake: Hash[untyped, untyped], ?auth_timeout_ms: Integer) -> void
      def open: () -> untyped
      def receive: (String payload) -> untyped
      def close: () -> untyped
      def ping: () -> untyped
      private
      def authenticate_with_timeout: () -> untyped
      def rpc: (Hash[String, untyped] frame) -> untyped
      def rpc_void: (Hash[String, untyped] frame) -> untyped
      def respond: (untyped id, ?result: untyped, ?error: String?, ?errors: Array[String]?) -> untyped
      def sanitize_uuid: (untyped value) -> String
      def parse_meta: (untyped value) -> Hash[String, untyped]
    end
  end
end
